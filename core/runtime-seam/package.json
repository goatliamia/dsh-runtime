{
  "name": "dsh-runtime-seam",
  "version": "0.1.0",
  "description": "Minimal Runtime capability seam for DSH: fact registry with authority/revision/fingerprint, teaching guard, circuit, committed delta, optional persistence — all evidence-backed (E1-E7).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatliamia/dsh-runtime.git",
    "directory": "core/runtime-seam"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
