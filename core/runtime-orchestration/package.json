{
  "name": "dsh-runtime-orchestration",
  "version": "0.1.0",
  "description": "Thin child-orchestration layer for DSH: wait on a child's terminal fact, derive its residency, wait for many. Consumes official facts only (subagent/start|end + agent/status); no polling, no new events, no core patch.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "runtime",
    "subagent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatliamia/dsh-runtime.git",
    "directory": "core/runtime-orchestration"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
